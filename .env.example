# =============================================================================
# Quantum-Safe Crypto Migration Agent — Environment Variables
# COPY THIS FILE TO .env AND FILL IN REAL VALUES.
# NEVER COMMIT .env TO GIT.
# This file contains PLACEHOLDERS ONLY — no real credentials.
# =============================================================================

# ---------------------------------------------------------------------------
# IBM watsonx.ai — LLM backend for AI-assisted analysis & migration planning
# ---------------------------------------------------------------------------
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Default model ID (e.g. ibm/granite-34b-code-instruct)
WATSONX_MODEL_ID=ibm/granite-34b-code-instruct

# ---------------------------------------------------------------------------
# IBM Watson Code Assistant (optional — if used separately from watsonx.ai)
# ---------------------------------------------------------------------------
# WCA_API_KEY=your_wca_api_key_here
# WCA_INSTANCE_URL=https://your-wca-instance.ibm.com

# ---------------------------------------------------------------------------
# CLI runtime configuration
# ---------------------------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Maximum number of parallel analysis workers
MAX_WORKERS=4

# Output format: text | json | markdown
DEFAULT_OUTPUT_FORMAT=text

# ---------------------------------------------------------------------------
# Migration engine
# ---------------------------------------------------------------------------
# Whether to enable LLM-assisted migration (vs deterministic-only)
ENABLE_LLM_MIGRATION=true

# Maximum LLM tokens for a single migration request
LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
# Timeout in seconds for post-migration build/test validation
VALIDATION_TIMEOUT_SECONDS=120
