# =============================================================================
# Quantum-Safe Crypto Migration Agent — Environment Variables
# COPY THIS FILE TO .env AND FILL IN REAL VALUES.
# NEVER COMMIT .env TO GIT.
# This file contains PLACEHOLDERS ONLY — no real credentials.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM provider — OpenAI-compatible Chat Completions API
#
# The tool works with ANY provider that implements the OpenAI API:
#   OpenAI       → leave LLM_BASE_URL blank, set LLM_API_KEY to your OpenAI key
#   Anthropic    → set LLM_BASE_URL to your Anthropic-compatible gateway URL
#   watsonx.ai   → set LLM_BASE_URL to the watsonx OpenAI-compatible endpoint
#   Ollama/local → LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama
#
# Switching provider requires ONLY changing these env vars — zero code change.
# ---------------------------------------------------------------------------

# API key for your chosen LLM provider
LLM_API_KEY=your_llm_api_key_here

# Base URL for OpenAI-compatible endpoint.
# Leave blank to use OpenAI's default (https://api.openai.com/v1).
# Examples:
#   watsonx.ai:  https://us-south.ml.cloud.ibm.com/ml/v1/text/chat
#   Ollama:      http://localhost:11434/v1
LLM_BASE_URL=

# Model identifier (must be valid for the chosen provider)
# Examples: gpt-4o | gpt-4-turbo | claude-3-5-sonnet-20241022 | ibm/granite-34b-code-instruct
LLM_MODEL=gpt-4o

# Maximum tokens per LLM request
LLM_MAX_TOKENS=4096

# Temperature for LLM generation (0.0 = deterministic, 0.2 = recommended for code)
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# IBM watsonx.ai — only needed if using watsonx as the LLM provider
# Set LLM_BASE_URL and LLM_API_KEY above; these are supplementary identifiers.
# ---------------------------------------------------------------------------
# WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ---------------------------------------------------------------------------
# CLI runtime configuration
# ---------------------------------------------------------------------------

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Maximum number of parallel analysis workers
MAX_WORKERS=4

# Output format: text | json | markdown
DEFAULT_OUTPUT_FORMAT=text

# ---------------------------------------------------------------------------
# Scan cache
# ---------------------------------------------------------------------------

# Enable on-disk scan cache to skip re-scanning unchanged files (true/false)
ENABLE_SCAN_CACHE=true

# Directory for scan cache files (relative to CWD or absolute path)
SCAN_CACHE_DIR=.qsma_cache

# ---------------------------------------------------------------------------
# Migration engine
# ---------------------------------------------------------------------------

# Enable LLM-assisted migration for complex/unknown patterns (true/false)
# When false, only deterministic AST rewrites are applied.
ENABLE_LLM_MIGRATION=true

# Timeout for post-migration build/test validation (seconds)
VALIDATION_TIMEOUT_SECONDS=120
