# =============================================================================
# Quantum-Safe Crypto Migration Agent — Environment Variables
# COPY THIS FILE TO .env AND FILL IN REAL VALUES.
# NEVER COMMIT .env TO GIT.
# This file contains PLACEHOLDERS ONLY — no real credentials.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider selection
#
# DEFAULT: watsonx  (IBM watsonx.ai — used for the hackathon)
# Options: watsonx | openai_compatible | anthropic_compatible
#
# Changing this value is the ONLY thing needed to switch providers.
# No code changes required.
# ---------------------------------------------------------------------------
LLM_PROVIDER=watsonx

# ---------------------------------------------------------------------------
# IBM watsonx.ai — DEFAULT PROVIDER
# Used when LLM_PROVIDER=watsonx (the default)
#
# Get these from: https://cloud.ibm.com → watsonx.ai project settings
# ---------------------------------------------------------------------------
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite Code model (default — change to any watsonx.ai model you have access to)
WATSONX_MODEL=ibm/granite-34b-code-instruct

# ---------------------------------------------------------------------------
# OpenAI-compatible provider (OPTIONAL)
# Used when LLM_PROVIDER=openai_compatible
# Requires: pip install 'qsma[llm-openai]'
#
# Works with: any endpoint that implements the OpenAI Chat Completions API.
# This includes OpenAI itself, Azure OpenAI, local Ollama, and others.
# These are COMPATIBLE keys/endpoints — not necessarily OpenAI keys specifically.
# ---------------------------------------------------------------------------
# LLM_API_KEY=your_openai_compatible_api_key_here
# LLM_BASE_URL=https://your-compatible-endpoint.example.com/v1
# LLM_MODEL=your-model-name-here

# ---------------------------------------------------------------------------
# Anthropic-compatible provider (OPTIONAL)
# Used when LLM_PROVIDER=anthropic_compatible
# Requires: pip install 'qsma[llm-anthropic]'
#
# Works with: any endpoint that implements the Anthropic Messages API.
# These are COMPATIBLE keys/endpoints — not necessarily Anthropic keys specifically.
# ---------------------------------------------------------------------------
# LLM_API_KEY=your_anthropic_compatible_api_key_here
# LLM_BASE_URL=https://your-compatible-endpoint.example.com
# LLM_MODEL=your-model-name-here

# ---------------------------------------------------------------------------
# Shared LLM settings (apply to all providers)
# ---------------------------------------------------------------------------

# Maximum tokens per LLM request
LLM_MAX_TOKENS=4096

# Generation temperature (0.0 = deterministic, 0.2 = recommended for code tasks)
LLM_TEMPERATURE=0.2

# Enable LLM-assisted migration for complex/unknown patterns (true/false)
# When false, only deterministic AST rewrites are applied. Scan still works fully.
ENABLE_LLM_MIGRATION=true

# ---------------------------------------------------------------------------
# CLI runtime configuration
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_WORKERS=4
DEFAULT_OUTPUT_FORMAT=text

# ---------------------------------------------------------------------------
# Scan cache
# ---------------------------------------------------------------------------
ENABLE_SCAN_CACHE=true
SCAN_CACHE_DIR=.qsma_cache

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
VALIDATION_TIMEOUT_SECONDS=120
